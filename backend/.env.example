# ---------------------------------------------------------------
# Backend environment variable template.
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is gitignored.
# ---------------------------------------------------------------

# Backend server
PORT=4000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string used by Prisma.
# Cloud PostgreSQL (Neon/Supabase): postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
# Or Local PostgreSQL / Docker: postgresql://placement:placement@localhost:5432/placement_portal
DATABASE_URL=postgresql://placement:placement@localhost:5432/placement_portal

# JWT authentication (Milestone 4) — use a long random string in real environments
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Directory for uploaded files (student profile photos), relative to the backend
# working directory unless absolute. Served publicly at /uploads/…
UPLOAD_DIR=uploads

